# Deployment configuration — mirrors the Railway service variables.
# Local dev does not need this file: `make dev` writes a .env with a fictitious
# superuser when none exists. For a deployment, copy to .env and fill real
# values. Copying it to .env for local dev instead means those fictitious
# credentials are never written: `make dev` keeps whatever .env it finds, so the
# dashboard superuser becomes the one set below. Local-only testing knobs live in
# .env.local.example instead; the suite battery uses its own dummy creds and
# reads neither file.
#
# Secret-bearing settings reach PocketBase through the env boot hooks in
# pb_hooks/, never through a migration — a migration re-asserting them would
# clobber the hook on a fresh boot.

# ── Server ────────────────────────────────────────────────────────────────
# Injected by Railway and most PaaS; the Dockerfile falls back to 8080.
PORT=8080
# Comma-separated allowed origins for the API. Default: *
PB_CORS_ORIGINS=*

# ── Superuser bootstrap (Dockerfile CMD) ──────────────────────────────────
# On a fresh volume these bootstrap the superuser; on later boots the create
# no-ops and leaves tokenKey intact.
PB_SUPERUSER_EMAIL=your-superuser@example.com
PB_SUPERUSER_PASSWORD=change-me-strong-password

# ── Transactional email (pb_hooks/mail.pb.js) ─────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
# Default: onboarding@resend.dev
MAIL_SENDER_ADDRESS=onboarding@resend.dev

# ── OAuth2 (pb_hooks/oauth.pb.js) ──────────────────────────────────────────
# `make dev`/`make backend` export this file into the pocketbase process, so
# filling these in lights up GitHub sign-in locally too — but GitHub classic
# OAuth Apps only support ONE callback URL each, so the prod app can't double as
# the local one. Register a separate dev-only OAuth App
# (github.com/settings/developers) and put THAT app's credentials here — not the
# prod app's.
GITHUB_CLIENT_ID=Iv1_xxxxxxxx
GITHUB_CLIENT_SECRET=github-oauth-client-secret
# Google sign-in rides the same hook: a Google OAuth client (Web application) from
# console.cloud.google.com with the client app's callback URL; both or neither.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-oauth-client-secret

# ── Backups to S3-compatible storage (pb_hooks/backups.pb.js) ─────────────
PB_BACKUPS_S3_BUCKET=pb-backups
PB_BACKUPS_S3_ENDPOINT=https://your-bucket-endpoint
PB_BACKUPS_S3_REGION=auto
PB_BACKUPS_S3_ACCESS_KEY=your-access-key-id
PB_BACKUPS_S3_SECRET=your-secret-access-key
# Daily S3 backup run (pb_hooks/backups.pb.js). Default: 0 3 * * *
PB_BACKUPS_CRON=0 3 * * *
# Default: 30
PB_BACKUPS_CRON_MAX_KEEP=30

# ── Alerting (pb_hooks/alerts.pb.js) ──────────────────────────────────────
# Unset ALERT_EMAIL disarms the alert hook entirely.
ALERT_EMAIL=you@example.com
# Error-rate scan that trips an alert email (pb_hooks/alerts.pb.js). Default: */5 * * * *
ALERT_CRON=*/5 * * * *
# Error count within ALERT_WINDOW_MIN that trips an alert. Default: 5
ALERT_THRESHOLD=5
# Default: 5
ALERT_WINDOW_MIN=5
# Minutes to suppress repeat alerts. Defaults to ALERT_WINDOW_MIN.
ALERT_COOLDOWN_MIN=5
# Set to any value to fire one alert at boot to prove the path. Leave unset in prod.
# ALERT_SELFTEST=1

# ── App administrators (pb_hooks/routes.pb.js) ────────────────────────────
# Comma-separated emails allowed to approve new accounts (decision:signup-approval). Env,
# not a DB row: app_settings is readable by every authenticated user, and
# nothing may grant this authority over the API. Unset = only a superuser can
# approve, from the dashboard. Match is case-insensitive; blanks are ignored.
APP_ADMIN_EMAILS=you@example.com

# ── Scheduled jobs ────────────────────────────────────────────────────────
# A malformed schedule below refuses server startup entirely — validate before deploying.
# Unread-notification digest (pb_hooks/notify.pb.js). Default: 0 8 * * *
DIGEST_CRON=0 8 * * *
# 30-day trash purge (pb_hooks/trash.pb.js). Default: 0 4 * * *
TRASH_PURGE_CRON=0 4 * * *
# Moves unfinished work from an ended cycle into the next one (pb_hooks/cycles.pb.js). Default: 0 6 * * *
CYCLE_ROLLOVER_CRON=0 6 * * *

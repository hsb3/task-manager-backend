# Secrets and machine-local config (may carry tokens or per-machine URLs); the *.example templates stay tracked.
.env*
!.env*.example
.kata.local.toml
.opencode/opencode.json
.claude/operations/
.claude/agent-memory/

# The owner's personal notes, never committed.
NOTES.md

# PocketBase binary, local data and logs: rebuilt from pb_migrations/ and scripts/seed.ts; a .zip may be a whole-database backup.
/pocketbase
pb_data/
pb.log
*.zip

# Installed and downloaded artifacts: bun install (clients/tm/ is a workspace with its own), CI's battery shard manifests.
node_modules/
battery-manifests/

# Machine state: in-project linked worktrees (a machine without the owner's global git ignore still needs this), the atelier handoff mtime, Finder metadata.
.worktrees/
.agents/handoff.stamp
.DS_Store

# >>> cc-project-memory (managed) >>>
# narrow-ignore: ignore only machine-local/transient; track everything else under .claude/
# (memory/, rules/, settings.json stay tracked & transferable)
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock
.claude/**/.DS_Store
# <<< cc-project-memory (managed) <<<

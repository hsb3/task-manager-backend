# One allowlist for both images built from the repository root (Dockerfile, services/mcp/Dockerfile).
# Allowlist so the whole repo (pb_data, .git, node_modules, nested worktrees, untracked secrets) is not shipped as context.
*
!pb_migrations
!pb_hooks
!package.json
!bun.lock
!clients/tm/package.json
!clients/tm/src
!services/mcp

{
  "name": "task-manager-infra",
  "private": true,
  "description": "Root manifest: the Railway IaC SDK (deploy/railway/railway.ts) and the Bun/TypeScript gate (typecheck + prettier) for e2e/, scripts/ and tests/.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"pb_hooks/**/*.js\"",
    "format": "prettier --write \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"pb_hooks/**/*.js\""
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "prettier": "3.9.6",
    "railway": "^3.10.0",
    "typescript": "6.0.3"
  }
}

# Local testing overrides — never deployed.
#
# NOT auto-loaded by anything in this repo today: scripts/seed.ts and every
# tests/test_*.ts that need PB_* vars call their own load_env(path=".env") —
# they read .env, not this file. Nothing sources .env.local. Treat this file
# as a reference for the knobs below, or export its contents yourself before
# a targeted run; copying it to .env.local alone has no effect.
#
# Deployment configuration lives in .env.example.
#
# The suite battery seeds its own dummy superuser and its own ports, so these
# knobs never apply to it regardless.

# ── Dev server the scripts and tests talk to ──────────────────────────────
# Read from .env (see above) by scripts/seed.ts and every tests/test_*.ts.
PB_URL=http://127.0.0.1:8090
# Superuser for scripts/seed.ts and the tests that need an admin session.
PB_SUPERUSER_EMAIL=your-superuser@example.com
PB_SUPERUSER_PASSWORD=change-me-strong-password

# ── Local paths (scripts/seed.ts, tests/test_files.ts) ────────────────────
# PB_BIN — the PocketBase binary. ./pocketbase is gitignored, so a fresh worktree
# has none; EXPORT this to reach the self-booting suites, scripts/gen_*.ts, the
# battery (they read the process env, not .env). seed.ts also reads it
# from .env, and still accepts the retired spelling PB_BINARY, which PB_BIN outranks.
PB_BIN=./pocketbase
PB_DATA_DIR=pb_data
PB_STORAGE_DIR=pb_data/storage

# ── Captured mail (scripts/smtp_sink.ts, tests/test_email.ts) ─────────────
MAIL_DIR=/tmp/pb_mail
MAIL_SINK_HOST=127.0.0.1
MAIL_SINK_PORT=2526
SINK_PORT=2527
# tests/test_hardening.ts runs its own sink on a separate port.
PB_MAILDIR=/tmp/pb_mail
PB_SINK_PORT=2527

# ── Battery knobs (scripts/run_suite_battery.sh) ──────────────────────────
# Keep each clean room's scratch dir after the run, to inspect a failure.
# KEEP_SCRATCH=1
# Ports the battery's own rooms bind. Stay inside the documented bands in
# .agents/rules/ports.md — 8090 is the dev server and is off-limits to tests.
# LEGACY_PORT=8091
# EMAIL_PORT=8092
# EMAIL_SINK_PORT=2526
# HARD_PORT=8093
# HARD_SINK_PORT=2527
# Stand-in Resend key so the mail path runs without a real account.
# DUMMY_RESEND_KEY=re_dummy

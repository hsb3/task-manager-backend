{
  "permissions": {
    "allow": [
      "Bash(gh run watch *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(make check)",
      "Bash(make check-static)",
      "Bash(make next-migration-slot)",
      "Bash(bun scripts/check_app_docs.ts)",
      "Bash(bun scripts/gen_openapi.ts --check)",
      "Bash(bun scripts/gen_decisions.ts --check)",
      "Bash(bun scripts/check_constants.ts)",
      "Bash(kata *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_historical_migrations/hook.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-desk@dotfiles-agents": true,
    "atelier@dotfiles-agents": true,
    "pocketbase@dotfiles-agents": true,
    "solo-skills@dotfiles-agents": true,
    "owner-signoff@dotfiles-agents": true
  }
}
